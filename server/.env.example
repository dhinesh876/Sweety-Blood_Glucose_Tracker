# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# PostgreSQL (matches docker-compose.yml at repo root)
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety

# Used only by `npm test` (integration tests wipe the tables in this database!)
TEST_DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety_test
